{
  "compilerOptions": {
    "target": "ES2022",
    // TypeScript 6.0 makes `strict` the default, so leaving it unset was a pin to <= 5.x
    // as much as a style choice. Turning it on cost four errors, three of which were the
    // same live defect: `useReducedMotionConfig()` returns `boolean | null` and the null
    // was reaching props typed `boolean`, where it read as falsy -- silently disabling
    // reduced motion on first render.
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "node",
      "vite/client"
    ],
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}