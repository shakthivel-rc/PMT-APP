# Base Project App — copy to .env.local and fill in. Never commit a filled-in copy.
#
# Vite only exposes variables prefixed VITE_ to client code, and vite.config.ts no
# longer overrides that guard. Everything the SPA needs at build time is listed here.

# Base URL the SPA prefixes onto every API call (src/api/client.ts).
# Default "/api" works in `npm run dev`, where vite proxies /api -> localhost:8000
# and STRIPS the /api prefix. `npm run preview` does NOT apply that proxy, so set an
# absolute URL when previewing a production build.
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------------------
# Client code holds no credentials of any kind. Secrets live only in the backend's
# environment (see pmt-api/.env.example) and never reach a browser.
